{
  "name": "mockblocks",
  "version": "0.1.0",
  "description": "Make pictures of block-based code from text, including mockups of blocks that do not exist yet.",
  "license": "MIT",
  "author": "Tim Radvan",
  "homepage": "https://github.com/AstroBlocksMod/mockblocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AstroBlocksMod/mockblocks.git"
  },
  "bugs": {
    "url": "https://github.com/AstroBlocksMod/mockblocks/issues"
  },
  "type": "module",
  "main": "build/mockblocks.min.js",
  "module": "build/mockblocks.min.es.js",
  "bin": {
    "mockblocks": "bin/mockblocks.js"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "rollup -c --environment buildTarget:PROD",
    "fmt": "prettier --cache --write *.js bin/*.js syntax/*.js syntax/packs/*.js scratch3/*.js locales-src/*.js snapshots/*.js snapshots/*.html tests/*.js",
    "lint": "eslint *.js bin/*.js syntax/*.js syntax/packs/*.js scratch3/*.js locales-src/*.js snapshots/*.js tests/*.js",
    "lint:staged": "lint-staged",
    "locales": "node locales-src/build-locales.js",
    "manual": "node ./snapshots/manual.js",
    "rollup": "rollup -c",
    "snapshots": "node ./snapshots/index.js",
    "start": "rollup -c -m -w",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "jsdom": "^30.1.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-external-helpers": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-package-json": "^2.8.0",
    "puppeteer": "^25.1.0",
    "rollup": "^4.62.0",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-serve": "^3.0.0",
    "scratch-l10n": "^6.1.86"
  },
  "keywords": [
    "blocks",
    "mockup",
    "scratch"
  ],
  "jest": {
    "transform": {}
  },
  "lint-staged": {
    "package.json": [
      "prettier-package-json --write",
      "git add"
    ],
    "*.js": [
      "prettier --write",
      "git add"
    ]
  },
  "pre-commit": "lint:staged",
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "arrowParens": "avoid"
  }
}
